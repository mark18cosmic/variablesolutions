# Required for "Start a project" submissions to be filed as GitHub issues.
# Create a token at https://github.com/settings/tokens (fine-grained: this
# repo only, Issues: Read and write) and set it here / in your host's env vars.
GITHUB_TOKEN=

# owner/repo — defaults to mark18cosmic/variablesolutions if unset.
GITHUB_REPO=mark18cosmic/variablesolutions
